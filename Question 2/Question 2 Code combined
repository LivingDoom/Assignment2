# Formats 'Tree' lines
def format_tree(node):
    if isinstance(node, float):
        if node % 1 == 0:
            return str(int(node))
        else:
            return str(node)

    kind = node[0]
    if kind == "num":
        number = node[1]
        if number % 1 == 0:
            return str(int(number))
        else:
            return str(number)
    if kind == "neg":
        return "(neg " + format_tree(node[1]) + ")"
    if kind == "Op":
        return "(" + node[1] + " " + format_tree(node[2]) + " " + format_tree(node[3]) + ")"

