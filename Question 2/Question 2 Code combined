
import os
import json
from typing import List, Tuple, Union
import re

# Type aliases
Token = Tuple[str, str]  # (type, value)
Expr = Union[float, Tuple]  # expression: number or operator tuple

def tokenize(expr_str: str) -> List[Token]:
    tokens = []
    token_pattern = r'(\d+\.?\d*|[+\-*/%^()])'
    
    for match in re.finditer(token_pattern, expr_str):
        value = match.group(1)
        if re.match(r'\d+\.?\d*', value):
            tokens.append(('NUMBER', value))
        else:
            tokens.append(('OP', value))
    
    return tokens

def create_parser(tokens: List[Token]):
    # Use a mutable list to manage state across functions without globals
    pos_state = [0]  

    def current() -> Token:
        pos = pos_state[0]
        if pos < len(tokens):
            return tokens[pos]
        return ('EOF', '')

    def advance() -> None:
        pos_state[0] += 1

    def match(tok_type: str, value: str = None) -> bool:
        t, v = current()
        if t == tok_type and (value is None or v == value):
            advance()
            return True
        return False

    def expr() -> Expr:
        left = term()
        while match('OP', '+') or match('OP', '-'):
            op = tokens[pos_state[0] - 1][1]
            right = term()
            left = ("Op", op, left, right)
        return left

    def term() -> Expr:
        left = unary()
        while True:
            if match('OP', '*') or match('OP', '/') or match('OP', '%'):
                op = tokens[pos_state[0] - 1][1]
                right = unary()
                left = ("Op", op, left, right)
            elif current()[0] == "LPAREN":
                right = unary()
                left = ("Op", "*", left, right)
            else:
                break
        return left

    def unary() -> Expr:
        if match('OP', '+'):
            raise SyntaxError("Unary plus is not supported")
        if match('OP', '-'):
            return ("neg", unary())
        return power()

    def power() -> Expr:
        left = primary()
        if match('OP', '^'):
            left = ("Op", "^", left, unary())  # right-associative, allow unary in exponent
        return left

    def primary() -> Expr:
        if match('NUM'):
            return float(tokens[pos_state[0] - 1][1])
        elif match('LPAREN', '('):
            left = expr()
            if not match('RPAREN', ')'):
                raise SyntaxError("Expected ')'")
            return left

    def parse() -> Expr:
        result = expr()
        if current()[0] != 'END':
            raise SyntaxError
        return result

    return parse

def evaluate(expr: Expr) -> float:
    if isinstance(expr, float):
        return expr
    
    if expr[0] == "Op":
        _, op, left, right = expr
        left_val = evaluate(left)
        right_val = evaluate(right)
        
        if op == '+':
            return left_val + right_val
        elif op == '-':
            return left_val - right_val
        elif op == '*':
            return left_val * right_val
        elif op == '/':
            return None if right_val == 0 else left_val / right_val
        elif op == '%':
            return None if right_val == 0 else left_val % right_val
        elif op == '^':
            return left_val ** right_val
    
    elif expr[0] == "neg":
        val_eval = evaluate(expr[1])
        return -val_eval




