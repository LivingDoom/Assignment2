def evaluate_file(input_path: str) -> list[dict]:
    results = []

#Read the file
    with open(input_path, "r") as f:
        for line in f:
            exp = line.strip()
            results.append(evaluate_exp(exp))

#Create output file
    output_path = r"output_combined.txt"
    
#Write the results
    with open(output_path, "w") as f:
        for item in results:
            f.write("Input: " + item["input"] + "\n")
            f.write("Tree: " + format_tree(item["tree"]) + "\n")
            f.write("Tokens: " + item["tokens"] + "\n")

            result = item["result"]

            if result == "ERROR":
                f.write("Result: ERROR\n")

            else:
                f.write("Result: " + format_result(result) + "\n")

            f.write("\n")

    return results

